TOOLCHAIN ?= $(OO_PS4_TOOLCHAIN)

CC           = clang
AR           = llvm-ar
LD           = ld.lld
CREATE_FSELF = $(TOOLCHAIN)/bin/linux/create-fself
PUBCMD       = $(TOOLCHAIN)/bin/linux/PkgTool.Core

OBJDIR = obj
BLDDIR = build
MODDIR = sce_module

TARGET     = remote_pkg_installer
CONTENT_ID = UP9000-FLTZ00003_00-REMOTEPKGINSTALL
TITLE_ID   = FLTZ00003
TITLE      = Remote PKG installer
APP_VER    = 01.00

ASM_SRCS = syscalls.S
C_SRCS   = http.c installer.c main.c net.c pkg.c server.c sfo.c util.c

SANDBIRD_LIB  = thirdparty/sandbird/build/libsandbird.a
TINY_JSON_LIB = thirdparty/tiny-json/build/libtiny_json.a

COMMON_FLAGS  = --target=x86_64-pc-freebsd12-elf -fPIC -funwind-tables
COMMON_FLAGS += -isysroot $(TOOLCHAIN) -isystem $(TOOLCHAIN)/include
COMMON_FLAGS += -I docker/oosdk_shim/include
COMMON_FLAGS += -I thirdparty/sandbird/src -I thirdparty/tiny-json -I thirdparty/uthash
COMMON_FLAGS += -Wall -fdiagnostics-color=always
COMMON_FLAGS += -DNDEBUG -D__BSD_VISIBLE -D_GNU_SOURCE -D_BSD_SOURCE -D_DEFAULT_SOURCE

CFLAGS  = $(COMMON_FLAGS)
CFLAGS += -std=c11
CFLAGS += -Wno-unused-function -Wno-unused-label -Wno-unused-variable -Werror=implicit-function-declaration
CFLAGS += -fno-strict-aliasing
CFLAGS += -O3

ASFLAGS = $(COMMON_FLAGS)

LIBS  = -L $(TOOLCHAIN)/lib
LIBS += -L thirdparty/sandbird/build -L thirdparty/tiny-json/build
LIBS += -lsandbird -ltiny_json
LIBS += -lc -lkernel -lc++
LIBS += -lSceSysmodule -lSceSystemService -lSceUserService
LIBS += -lSceNetCtl -lSceNet -lSceHttp -lSceSsl
LIBS += -lSceAppInstUtil -lSceBgft -lSceNpCommon -lSceNpUtility

LDFLAGS = -m elf_x86_64 -pie --script $(TOOLCHAIN)/link.x --eh-frame-hdr

OBJS = $(addprefix $(OBJDIR)/,$(ASM_SRCS:.S=.S.o) $(C_SRCS:.c=.c.o))

.PHONY: all clean pre-build thirdparty sfo eboot pkg

all: pkg

pre-build:
	@mkdir -p $(MODDIR) $(OBJDIR) $(BLDDIR)
	@mkdir -p thirdparty/sandbird/obj/src thirdparty/sandbird/build
	@mkdir -p thirdparty/tiny-json/obj thirdparty/tiny-json/build

$(SANDBIRD_LIB): thirdparty/sandbird/src/sandbird.c
	@mkdir -p thirdparty/sandbird/obj/src thirdparty/sandbird/build
	$(CC) $(CFLAGS) -c $< -o thirdparty/sandbird/obj/src/sandbird.c.o
	$(AR) rc $@ thirdparty/sandbird/obj/src/sandbird.c.o

$(TINY_JSON_LIB): thirdparty/tiny-json/tiny-json.c
	@mkdir -p thirdparty/tiny-json/obj thirdparty/tiny-json/build
	$(CC) $(CFLAGS) -c $< -o thirdparty/tiny-json/obj/tiny-json.c.o
	$(AR) rc $@ thirdparty/tiny-json/obj/tiny-json.c.o

thirdparty: $(SANDBIRD_LIB) $(TINY_JSON_LIB)

$(OBJDIR)/%.S.o: %.S
	@mkdir -p $(dir $@)
	$(CC) $(ASFLAGS) -c $< -o $@

$(OBJDIR)/%.c.o: %.c
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -c $< -o $@

eboot: pre-build thirdparty $(OBJS)
	$(LD) $(LDFLAGS) -o $(BLDDIR)/$(TARGET).elf $(TOOLCHAIN)/lib/crt1.o $(OBJS) $(LIBS)
	$(CREATE_FSELF) -in=$(BLDDIR)/$(TARGET).elf -out=$(BLDDIR)/$(TARGET).oelf --eboot=$(BLDDIR)/$(TARGET).self --paid=0x3800000000000010

sfo: pre-build
	$(PUBCMD) sfo_new $(BLDDIR)/param.sfo
	$(PUBCMD) sfo_setentry $(BLDDIR)/param.sfo APP_TYPE --type Integer --maxsize 4 --value 0
	$(PUBCMD) sfo_setentry $(BLDDIR)/param.sfo APP_VER --type Utf8 --maxsize 8 --value '$(APP_VER)'
	$(PUBCMD) sfo_setentry $(BLDDIR)/param.sfo ATTRIBUTE --type Integer --maxsize 4 --value 18
	$(PUBCMD) sfo_setentry $(BLDDIR)/param.sfo CATEGORY --type Utf8 --maxsize 4 --value 'gde'
	$(PUBCMD) sfo_setentry $(BLDDIR)/param.sfo CONTENT_ID --type Utf8 --maxsize 48 --value '$(CONTENT_ID)'
	$(PUBCMD) sfo_setentry $(BLDDIR)/param.sfo DOWNLOAD_DATA_SIZE --type Integer --maxsize 4 --value 0
	$(PUBCMD) sfo_setentry $(BLDDIR)/param.sfo FORMAT --type Utf8 --maxsize 4 --value 'obs'
	$(PUBCMD) sfo_setentry $(BLDDIR)/param.sfo PARENTAL_LEVEL --type Integer --maxsize 4 --value 1
	$(PUBCMD) sfo_setentry $(BLDDIR)/param.sfo SYSTEM_VER --type Integer --maxsize 4 --value 1020
	$(PUBCMD) sfo_setentry $(BLDDIR)/param.sfo TITLE --type Utf8 --maxsize 128 --value '$(TITLE)'
	$(PUBCMD) sfo_setentry $(BLDDIR)/param.sfo TITLE_ID --type Utf8 --maxsize 12 --value '$(TITLE_ID)'
	$(PUBCMD) sfo_setentry $(BLDDIR)/param.sfo VERSION --type Utf8 --maxsize 8 --value '$(APP_VER)'

pkg: sfo eboot
	@sed -e 's/orig_path="build\\/orig_path="/g' -e 's/orig_path="sce_sys\\/orig_path="..\/sce_sys\//g' $(TARGET).gp4 > $(BLDDIR)/$(TARGET).gp4
	$(PUBCMD) pkg_build $(BLDDIR)/$(TARGET).gp4 $(BLDDIR)
	@cp -f $(BLDDIR)/$(CONTENT_ID).pkg $(BLDDIR)/$(TARGET).pkg
	@echo "Successfully built $(BLDDIR)/$(TARGET).pkg"

clean:
	@rm -rf $(OBJDIR) $(BLDDIR)
	@rm -rf thirdparty/sandbird/obj thirdparty/sandbird/build
	@rm -rf thirdparty/tiny-json/obj thirdparty/tiny-json/build

